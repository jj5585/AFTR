# ==============================================================================
# AFTR Production & Staging Environment Configuration Template (.env.production.example)
#
# DO NOT COMMIT ACTUAL PRODUCTION VALUES TO VERSION CONTROL.
# Store production secrets in a managed vault (AWS Secrets Manager, Doppler, GCP Secret Manager).
# ==============================================================================

# Core Application Environment
ENVIRONMENT=production
DEBUG=False
LOG_LEVEL=WARNING

# Backend API Host Configuration
HOST=0.0.0.0
PORT=8000
WEB_CONCURRENCY=4

# Application Secret Key (Used for internal HMAC-SHA256 signatures & general salts)
# Generate with: openssl rand -hex 32
SECRET_KEY=replace-with-cryptographically-secure-random-64-char-hex-secret

# Salt for Recipient Email HMAC-SHA256 Hashing (Never rotate once active)
# Generate with: openssl rand -hex 32
INVITATION_SALT=replace-with-stable-cryptographically-secure-salt-hex

# Message Storage Encryption Key (Fernet 32-byte URL-safe base64 key)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MESSAGE_ENCRYPTION_KEY=replace-with-fernet-urlsafe-base64-key==

# Master Base32 Secret for Security Administrator RFC 6238 TOTP Verification
# Generate with: python -c "import pyotp; print(pyotp.random_base32())"
SECURITY_ADMIN_MFA_SECRET=JBSWY3DPEHPK3PXP

# Database Configuration (Supabase PostgreSQL 16)
# Use Transaction Pooling port (6543) with PgBouncer for FastAPI asyncpg connections:
DATABASE_URL=postgresql+asyncpg://aftr_app:replace_db_password@db.xxx.supabase.co:6543/postgres?ssl=require
# Direct Session port (5432) used ONLY for running Alembic migrations in CI/CD pipeline:
MIGRATION_DATABASE_URL=postgresql+asyncpg://postgres:replace_db_admin_password@db.xxx.supabase.co:5432/postgres?ssl=require

# Redis Configuration (Managed Redis 7 with TLS enabled)
# Used for sliding window rate limiting, active WebSocket presence, and killswitch flags
REDIS_URL=rediss://default:replace_redis_token@xxx.upstash.io:6379

# Supabase Auth & JWT Verification
SUPABASE_URL=https://your-production-app.supabase.co
SUPABASE_ANON_KEY=replace-with-production-anon-key
SUPABASE_JWT_SECRET=replace-with-production-jwt-secret-for-backend-verification
SUPABASE_SERVICE_ROLE_KEY=replace-with-backend-only-service-role-key-NEVER-EXPOSE-TO-FRONTEND

# Invitation Quota & Lifespan Policy (Strict AFTR Rules)
INVITATION_EXPIRATION_HOURS=72
INITIAL_INVITE_QUOTA=3

# Rate Limiting Parameters (Sliding Window in Seconds)
AUTH_RATE_LIMIT_REQUESTS=10
AUTH_RATE_LIMIT_WINDOW=60
INVITE_RATE_LIMIT_REQUESTS=15
INVITE_RATE_LIMIT_WINDOW=60
PUBLIC_API_RATE_LIMIT_REQUESTS=120
PUBLIC_API_RATE_LIMIT_WINDOW=60

# Production Allowed Origins (Strict Cross-Origin Resource Sharing)
CORS_ORIGINS=https://beta.aftr.app,https://aftr.app

# ==============================================================================
# Frontend Environment Variables (Vercel Edge & Client Bundles)
# ONLY VARIABLES PREFIXED WITH NEXT_PUBLIC_ ARE BUNDLED INTO CLIENT JS.
# NEVER EXPOSE SERVICE ROLE KEYS, INVITATION SALTS, OR DB CREDENTIALS HERE.
# ==============================================================================
NEXT_PUBLIC_API_URL=https://api.aftr.app
NEXT_PUBLIC_SUPABASE_URL=https://your-production-app.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-production-anon-key
